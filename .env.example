# Copy to .env.local and fill in. These are public (inlined into the browser bundle) — never put secrets here.

# Backend API base URL, including any path prefix and a trailing slash,
# e.g. https://api.example.com/api/v1/
NEXT_PUBLIC_API_URL=

# Base URL that relative image paths from the API are joined onto,
# e.g. https://api.example.com/
NEXT_PUBLIC_IMAGE_URL=
