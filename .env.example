# Copy to .env.local and fill in. These are public (inlined into the browser bundle) — never put secrets here.

# Backend API base URL, including any path prefix and a trailing slash,
# e.g. https://api.example.com/api/v1/
NEXT_PUBLIC_API_URL=

# Base URL that relative image paths from the API are joined onto,
# e.g. https://api.example.com/
NEXT_PUBLIC_IMAGE_URL=

# Optional. The site's canonical address, used in page metadata, the sitemap
# and robots.txt. Defaults to https://hashtagbillionaire.com.
NEXT_PUBLIC_SITE_URL=

# Optional. Set to true on staging and previews so search engines stay out
# (robots.txt disallows everything and pages say noindex). Leave unset in production.
NEXT_PUBLIC_NOINDEX=

# Optional. Cloudflare Turnstile site key from the client's Cloudflare account. Shows the widget on
# the Support and sourcing forms. Set it before TURNSTILE_SECRET_KEY goes on the backend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
